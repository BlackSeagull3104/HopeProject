{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hope Archive",
  "version": "0.1.0",
  "identifier": "io.github.blackseagull3104.hopearchive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Hope Archive", "width": 1360, "height": 900, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/hope-archive-backend"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"]
  }
}
